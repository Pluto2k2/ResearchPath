# HTTP port the server listens on.
# In production Render sets PORT itself; do not hardcode it there.
PORT=3000
# SQLite database file (use :memory: for a throwaway database).
# In production it stays on the container filesystem. On the Render free plan
# the disk is not persistent: data is lost on every redeploy, restart or
# spin-down (demo only).
DB_PATH=./data/researchpath.db
# development or production.
# Production uses NODE_ENV=production (already set in the Docker image).
NODE_ENV=development
# Optional e-mail sent as `mailto` to the OpenAlex API so requests use its
# "polite pool" (faster, more reliable). Leave empty to omit it.
# OPENALEX_MAILTO=
